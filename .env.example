COMPOSE_PROJECT_NAME=todo-go

POSTGRES_DB=todo_go
POSTGRES_USER=todo_go
POSTGRES_PASSWORD=replace_me
POSTGRES_PORT=5432

APP_ENV=development
APP_HOST=127.0.0.1
