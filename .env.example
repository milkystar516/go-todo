COMPOSE_PROJECT_NAME=go-todo
IMAGE_TARGET=development

POSTGRES_DB=go_todo
POSTGRES_USER=go_todo
POSTGRES_PASSWORD=replace_me
POSTGRES_PORT=5432

APP_HOST=127.0.0.1
APP_PORT=8080
FRONTEND_PORT=5173

API_PROXY_TARGET=http://127.0.0.1:8080

LOG_LEVEL=debug

DATABASE_URL=postgres://go_todo:replace_me@127.0.0.1:5432/go_todo?sslmode=disable

SESSION_COOKIE_NAME=go_todo_session
SESSION_TTL=24h
SESSION_SECURE=false
